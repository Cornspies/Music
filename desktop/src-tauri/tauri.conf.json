{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music",
  "identifier": "com.cornspies.music",
  "build": {
    "frontendDist": "../../.next-desktop",
    "devUrl": "http://localhost:3010",
    "beforeDevCommand": {
      "script": "bun run dev:desktop",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "bun run build:desktop",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Music",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#09090b",
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: http: https: music-cover:",
        "media-src": "'self' blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "app", "dmg"],
    "category": "Music",
    "shortDescription": "Music player for your Music server",
    "longDescription": "Plays your library from a Music server: favourites, playlists, history and Listen Together.",
    "publisher": "Cornspies",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2 | libasound2t64"
        ],
        "desktopTemplate": "linux/music.desktop"
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ],
        "desktopTemplate": "linux/music.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cornspies-music"
        ]
      }
    }
  }
}
